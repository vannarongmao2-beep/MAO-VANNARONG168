generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model User {
  id           String   @id @default(uuid())
  email        String   @unique
  passwordHash String
  role         Role     @default(MEMBER)
  member       Member?
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt
}

enum Role {
  ADMIN
  FAMILY_LEADER
  MEMBER
}

model FamilyNode {
  id          String       @id @default(uuid())
  name        String
  type        NodeType     
  parentId    String?
  parent      FamilyNode?  @relation("FamilyHierarchy", fields: [parentId], references: [id])
  children    FamilyNode[] @relation("FamilyHierarchy")
  members     Member[]
  createdAt   DateTime     @default(now())
}

enum NodeType {
  BIG_FAMILY
  SMALL_FAMILY
  INDIVIDUAL_FAMILY
  NO_FAMILY
}

model Member {
  id             String      @id @default(uuid())
  userId         String?     @unique
  user           User?       @relation(fields: [userId], references: [id])
  familyId       String
  family         FamilyNode  @relation(fields: [familyId], references: [id])
  fullName       String
  nickname       String?
  gender         String
  birthday       DateTime?
  phone          String?
  email          String?
  relationship   String
  occupation     String?
  photoUrl       String?
  status         String      @default("ACTIVE")
  joinDate       DateTime    @default(now())
  
  expenses       Expense[]
  incomes        Income[]
  debts          Debt[]
  savings        Saving[]
}

model Expense {
  id          String   @id @default(uuid())
  memberId    String
  member      Member   @relation(fields: [memberId], references: [id])
  title       String
  description String?
  category    String   
  amount      Decimal  @db.Decimal(12, 2)
  date        DateTime
  paidBy      String?
  receiptUrl  String?
  createdAt   DateTime @default(now())
}

model Income {
  id          String   @id @default(uuid())
  memberId    String
  member      Member   @relation(fields: [memberId], references: [id])
  source      String
  amount      Decimal  @db.Decimal(12, 2)
  date        DateTime
  notes       String?
  createdAt   DateTime @default(now())
}

model Debt {
  id          String   @id @default(uuid())
  memberId    String
  member      Member   @relation(fields: [memberId], references: [id])
  title       String
  amount      Decimal  @db.Decimal(12, 2)
  dueDate     DateTime?
  createdAt   DateTime @default(now())
}

model Saving {
  id          String   @id @default(uuid())
  memberId    String
  member      Member   @relation(fields: [memberId], references: [id])
  title       String
  amount      Decimal  @db.Decimal(12, 2)
  createdAt   DateTime @default(now())
}
